# App — only these NEXT_PUBLIC_* values are allowed in the browser bundle.
NEXT_PUBLIC_APP_NAME=BusinessOS One
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — INDEPENDENTE do BusinessOS Finance
# Finance = localhost:5432 / businessos_finance
# Odonto  = localhost:5433 / businessos_odonto (conflito histórico com o plano 5433)
# One     = localhost:5434 / businessos_one
# Produção: use um PostgreSQL dedicado. Nunca aponte para o banco do Finance.
DATABASE_URL=postgresql://businessos:businessos@localhost:5434/businessos_one?schema=public

# Auth.js
# Gere um segredo longo (ex.: openssl rand -base64 32). Nunca use NEXT_PUBLIC_ para isto.
AUTH_SECRET=generate-a-long-random-secret
# Produção: URL pública HTTPS (ex.: https://one.seudominio.com)
AUTH_URL=http://localhost:3000

# WhatsApp (FASE 12) — envio manual via wa.me. Sem provedor oficial nesta fase.
# Não configure credenciais fictícias. Integração Meta/provedor fica para fase futura.

# Storage (FASE 14) — arquivos locais por tenant (logos). Backup necessário no deploy.
# STORAGE_ROOT=storage/tenants

# Scripts verify:* recusam NODE_ENV=production e URLs remotas, salvo VERIFY_REMOTE=1
# em um banco One de teste dedicado (nunca o banco de clientes reais).
