generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
  FINANCE
  INVENTORY
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  DEBUG
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum LeadOrigin {
  WEBSITE
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  REFERRAL
  ECOMMERCE
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum OpportunityStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  MEETING
  WHATSAPP
  EMAIL
  TASK
  NOTE
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  RETURN
  LOSS
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  accounts           Account[]
  sessions           Session[]
  memberships        Membership[]
  auditLogs          AuditLog[]
  systemLogs         SystemLog[]
  invitesSent        Invite[]     @relation("InviteInviter")
  customersOwned     Customer[]   @relation("CustomerOwner")
  leadsOwned         Lead[]       @relation("LeadOwner")
  opportunitiesOwned Opportunity[] @relation("OpportunityOwner")
  activitiesOwned    Activity[]    @relation("ActivityOwner")
  inventoryMovements InventoryMovement[] @relation("InventoryMovementCreator")

  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships Membership[]
  settings    CompanySettings?
  invites     Invite[]
  auditLogs   AuditLog[]
  systemLogs  SystemLog[]
  customers   Customer[]
  leads       Lead[]
  opportunities Opportunity[]
  activities    Activity[]
  productCategories ProductCategory[]
  products          Product[]
  inventories       Inventory[]
  inventoryMovements InventoryMovement[]

  @@index([deletedAt])
}

model Membership {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  role      Role      @default(SALES)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, deletedAt])
  @@index([userId, deletedAt])
}

model CompanySettings {
  id         String   @id @default(cuid())
  companyId  String   @unique
  theme      String   @default("light")
  language   String   @default("pt-BR")
  currency   String   @default("BRL")
  timezone   String   @default("America/Sao_Paulo")
  dateFormat String   @default("dd/MM/yyyy")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Invite {
  id          String       @id @default(cuid())
  companyId   String
  email       String
  role        Role         @default(SALES)
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("InviteInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([email, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  module    String
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([module, action])
}

model SystemLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  level     LogLevel @default(INFO)
  module    String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([level, createdAt])
  @@index([module, createdAt])
}

model Customer {
  id         String         @id @default(cuid())
  companyId  String
  type       CustomerType   @default(INDIVIDUAL)
  name       String
  tradeName  String?
  document   String?
  email      String?
  phone      String?
  mobile     String?
  whatsapp   String?
  zipCode    String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  country    String         @default("BR")
  status     CustomerStatus @default(ACTIVE)
  origin     String?
  notes      String?        @db.Text
  ownerId    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   User?   @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedFromLeads Lead[] @relation("LeadConvertedCustomer")
  opportunities Opportunity[]
  activities Activity[]

  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@index([companyId, email])
  @@index([companyId, document])
  @@index([companyId, status, deletedAt])
  @@index([companyId, origin, deletedAt])
  @@index([companyId, ownerId, deletedAt])
  @@index([companyId, createdAt])
}

model Lead {
  id              String     @id @default(cuid())
  companyId       String
  name            String
  companyName     String?
  email           String?
  phone           String?
  whatsapp        String?
  origin          LeadOrigin @default(OTHER)
  status          LeadStatus @default(NEW)
  ownerId         String?
  estimatedValue  Decimal?   @db.Decimal(14, 2)
  notes           String?    @db.Text
  /// Reserved for future Lead → Customer conversion (FASE 4.3+)
  convertedCustomerId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner             User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedCustomer Customer? @relation("LeadConvertedCustomer", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  opportunities     Opportunity[]
  activities        Activity[]

  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@index([companyId, email])
  @@index([companyId, status, deletedAt])
  @@index([companyId, origin, deletedAt])
  @@index([companyId, ownerId, deletedAt])
  @@index([companyId, createdAt])
  @@index([convertedCustomerId])
}

model Opportunity {
  id                String           @id @default(cuid())
  companyId         String
  name              String
  leadId            String?
  customerId        String?
  ownerId           String?
  stage             OpportunityStage @default(NEW)
  estimatedValue    Decimal?         @db.Decimal(14, 2)
  probability       Int              @default(10)
  expectedCloseDate DateTime?
  notes             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner    User?     @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[]

  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@index([companyId, stage, deletedAt])
  @@index([companyId, ownerId, deletedAt])
  @@index([companyId, expectedCloseDate])
  @@index([companyId, createdAt])
  @@index([leadId])
  @@index([customerId])
}

model Activity {
  id            String         @id @default(cuid())
  companyId     String
  title         String
  description   String?        @db.Text
  type          ActivityType   @default(TASK)
  status        ActivityStatus @default(PENDING)
  ownerId       String?
  dueAt         DateTime?
  completedAt   DateTime?
  customerId    String?
  leadId        String?
  opportunityId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner       User?        @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([companyId, deletedAt])
  @@index([companyId, status, deletedAt])
  @@index([companyId, type, deletedAt])
  @@index([companyId, ownerId, deletedAt])
  @@index([companyId, dueAt])
  @@index([customerId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([companyId, createdAt])
}

model ProductCategory {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@index([companyId, createdAt])
}

model Product {
  id          String        @id @default(cuid())
  companyId   String
  name        String
  sku         String
  barcode     String?
  description String?       @db.Text
  type        ProductType   @default(PRODUCT)
  categoryId  String?
  costPrice   Decimal       @default(0) @db.Decimal(14, 2)
  salePrice   Decimal       @default(0) @db.Decimal(14, 2)
  status      ProductStatus @default(ACTIVE)
  imageUrl    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventory Inventory?
  inventoryMovements InventoryMovement[]

  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@index([companyId, sku])
  @@index([companyId, barcode])
  @@index([companyId, type, deletedAt])
  @@index([companyId, status, deletedAt])
  @@index([companyId, categoryId, deletedAt])
  @@index([companyId, createdAt])
}

model Inventory {
  id              String   @id @default(cuid())
  companyId       String
  productId       String   @unique
  quantity        Int      @default(0)
  minimumQuantity Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, productId])
  @@index([companyId])
  @@index([companyId, quantity])
}

model InventoryMovement {
  id          String                @id @default(cuid())
  companyId   String
  productId   String
  type        InventoryMovementType
  quantity    Int
  reason      String?
  notes       String?               @db.Text
  createdById String?
  createdAt   DateTime              @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("InventoryMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, productId, createdAt])
  @@index([companyId, createdAt])
  @@index([productId])
}
