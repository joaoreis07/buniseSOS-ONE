generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
  FINANCE
  INVENTORY
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  DEBUG
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum LeadOrigin {
  WEBSITE
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  REFERRAL
  ECOMMERCE
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum OpportunityStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  MEETING
  WHATSAPP
  EMAIL
  TASK
  NOTE
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  RETURN
  LOSS
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  CARD
  CARD_CREDIT
  CARD_DEBIT
  TED
  OTHER
}

enum SalePaymentMode {
  CASH
  INSTALLMENT
}

enum InstallmentPeriod {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum ReceivableStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum CommunicationChannel {
  WHATSAPP
  EMAIL
  SMS
  INTERNAL
  OTHER
}

enum CommunicationType {
  MANUAL
  REMINDER
  FOLLOW_UP
  TRANSACTIONAL
  OTHER
}

enum CommunicationStatus {
  PREPARED
  OPENED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum CommunicationOrigin {
  CRM
  SALE
  FINANCE
  ACTIVITY
  MANUAL
  SYSTEM
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  OVERDUE_RECEIVABLE
  PAYMENT_RECEIVED
  SALE_COMPLETED
  PURCHASE_RECEIVED
  TASK_ASSIGNED
  SYSTEM
}

enum OperationalDocumentKind {
  SALE_RECEIPT
  PAYMENT_RECEIPT
  PURCHASE_RECORD
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  accounts           Account[]
  sessions           Session[]
  memberships        Membership[]
  auditLogs          AuditLog[]
  systemLogs         SystemLog[]
  invitesSent        Invite[]     @relation("InviteInviter")
  customersOwned     Customer[]   @relation("CustomerOwner")
  leadsOwned         Lead[]       @relation("LeadOwner")
  opportunitiesOwned Opportunity[] @relation("OpportunityOwner")
  activitiesOwned    Activity[]    @relation("ActivityOwner")
  inventoryMovements InventoryMovement[] @relation("InventoryMovementCreator")
  salesSold          Sale[]              @relation("SaleSeller")
  installmentPayments InstallmentPayment[] @relation("InstallmentPaymentReceiver")
  purchasesCreated   Purchase[]          @relation("PurchaseCreator")
  communications     Communication[]     @relation("CommunicationAuthor")
  notifications      Notification[]      @relation("NotificationRecipient")
  operationalDocuments OperationalDocument[] @relation("OperationalDocumentCreator")

  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id          String    @id @default(cuid())
  name        String
  tradeName   String?
  document    String?
  email       String?
  phone       String?
  whatsapp    String?
  website     String?
  description String?   @db.Text
  zipCode     String?
  street      String?
  number      String?
  complement  String?
  district    String?
  city        String?
  state       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  memberships Membership[]
  settings    CompanySettings?
  invites     Invite[]
  auditLogs   AuditLog[]
  systemLogs  SystemLog[]
  customers   Customer[]
  leads       Lead[]
  opportunities Opportunity[]
  activities    Activity[]
  productCategories ProductCategory[]
  products          Product[]
  inventories       Inventory[]
  inventoryMovements InventoryMovement[]
  sales             Sale[]
  saleItems         SaleItem[]
  accountReceivables AccountReceivable[]
  installments       Installment[]
  installmentPayments InstallmentPayment[]
  suppliers          Supplier[]
  purchases          Purchase[]
  purchaseItems      PurchaseItem[]
  communicationTemplates CommunicationTemplate[]
  communications         Communication[]
  notifications          Notification[]
  documentSequences      DocumentSequence[]
  operationalDocuments   OperationalDocument[]

  @@index([deletedAt])
}

model Membership {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  role      Role      @default(SALES)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, deletedAt])
  @@index([userId, deletedAt])
}

model CompanySettings {
  id                       String   @id @default(cuid())
  companyId                String   @unique
  theme                    String   @default("light")
  language                 String   @default("pt-BR")
  currency                 String   @default("BRL")
  timezone                 String   @default("America/Sao_Paulo")
  dateFormat               String   @default("dd/MM/yyyy")
  displayName              String?
  logoPath                 String?
  primaryColor             String   @default("#047857")
  secondaryColor           String   @default("#0f172a")
  documentTitle            String?
  documentHeader           String?  @db.Text
  documentFooter           String?  @db.Text
  communicationSignature   String?  @db.Text
  defaultSaleNotes         String?  @db.Text
  defaultPurchaseNotes     String?  @db.Text
  defaultReceiptNotes      String?  @db.Text
  allowSaleWithoutCustomer Boolean  @default(true)
  defaultInstallmentCount  Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Invite {
  id          String       @id @default(cuid())
  companyId   String
  email       String
  role        Role         @default(SALES)
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("InviteInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([email, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  module    String
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([module, action])
}

model SystemLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  level     LogLevel @default(INFO)
  module    String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([level, createdAt])
  @@index([module, createdAt])
}

model Customer {
  id         String         @id @default(cuid())
  companyId  String
  type       CustomerType   @default(INDIVIDUAL)
  name       String
  tradeName  String?
  document   String?
  email      String?
  phone      String?
  mobile     String?
  whatsapp   String?
  zipCode    String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  country    String         @default("BR")
  status     CustomerStatus @default(ACTIVE)
  origin     String?
  notes      String?        @db.Text
  ownerId    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   User?   @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedFromLeads Lead[] @relation("LeadConvertedCustomer")
  opportunities Opportunity[]
  activities Activity[]
  sales      Sale[]
  accountReceivables AccountReceivable[]
  communications     Communication[]

  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@index([companyId, email])
  @@index([companyId, document])
  @@index([companyId, status, deletedAt])
  @@index([companyId, origin, deletedAt])
  @@index([companyId, ownerId, deletedAt])
  @@index([companyId, createdAt])
}

model Lead {
  id              String     @id @default(cuid())
  companyId       String
  name            String
  companyName     String?
  email           String?
  phone           String?
  whatsapp        String?
  origin          LeadOrigin @default(OTHER)
  status          LeadStatus @default(NEW)
  ownerId         String?
  estimatedValue  Decimal?   @db.Decimal(14, 2)
  notes           String?    @db.Text
  /// Reserved for future Lead → Customer conversion (FASE 4.3+)
  convertedCustomerId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner             User?     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedCustomer Customer? @relation("LeadConvertedCustomer", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  opportunities     Opportunity[]
  activities        Activity[]

  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@index([companyId, email])
  @@index([companyId, status, deletedAt])
  @@index([companyId, origin, deletedAt])
  @@index([companyId, ownerId, deletedAt])
  @@index([companyId, createdAt])
  @@index([convertedCustomerId])
}

model Opportunity {
  id                String           @id @default(cuid())
  companyId         String
  name              String
  leadId            String?
  customerId        String?
  ownerId           String?
  stage             OpportunityStage @default(NEW)
  estimatedValue    Decimal?         @db.Decimal(14, 2)
  probability       Int              @default(10)
  expectedCloseDate DateTime?
  notes             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner    User?     @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities Activity[]

  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@index([companyId, stage, deletedAt])
  @@index([companyId, ownerId, deletedAt])
  @@index([companyId, expectedCloseDate])
  @@index([companyId, createdAt])
  @@index([leadId])
  @@index([customerId])
}

model Activity {
  id            String         @id @default(cuid())
  companyId     String
  title         String
  description   String?        @db.Text
  type          ActivityType   @default(TASK)
  status        ActivityStatus @default(PENDING)
  ownerId       String?
  dueAt         DateTime?
  completedAt   DateTime?
  customerId    String?
  leadId        String?
  opportunityId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner       User?        @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  communications Communication[]

  @@index([companyId, deletedAt])
  @@index([companyId, status, deletedAt])
  @@index([companyId, type, deletedAt])
  @@index([companyId, ownerId, deletedAt])
  @@index([companyId, dueAt])
  @@index([customerId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([companyId, createdAt])
}

model ProductCategory {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@index([companyId, createdAt])
}

model Product {
  id          String        @id @default(cuid())
  companyId   String
  name        String
  sku         String
  barcode     String?
  description String?       @db.Text
  type        ProductType   @default(PRODUCT)
  categoryId  String?
  costPrice   Decimal       @default(0) @db.Decimal(14, 2)
  salePrice   Decimal       @default(0) @db.Decimal(14, 2)
  status      ProductStatus @default(ACTIVE)
  imageUrl    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventory Inventory?
  inventoryMovements InventoryMovement[]
  saleItems SaleItem[]
  purchaseItems PurchaseItem[]

  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@index([companyId, sku])
  @@index([companyId, barcode])
  @@index([companyId, type, deletedAt])
  @@index([companyId, status, deletedAt])
  @@index([companyId, categoryId, deletedAt])
  @@index([companyId, createdAt])
}

model Inventory {
  id              String   @id @default(cuid())
  companyId       String
  productId       String   @unique
  quantity        Int      @default(0)
  minimumQuantity Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, productId])
  @@index([companyId])
  @@index([companyId, quantity])
}

model InventoryMovement {
  id          String                @id @default(cuid())
  companyId   String
  productId   String
  type        InventoryMovementType
  quantity    Int
  reason      String?
  notes       String?               @db.Text
  saleId      String?
  purchaseId  String?
  createdById String?
  createdAt   DateTime              @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale      Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase  Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("InventoryMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, productId, createdAt])
  @@index([companyId, createdAt])
  @@index([productId])
  @@index([saleId])
  @@index([purchaseId])
}

model Sale {
  id                String            @id @default(cuid())
  companyId         String
  customerId        String?
  sellerId          String
  number            Int
  status            SaleStatus        @default(DRAFT)
  paymentMethod     PaymentMethod     @default(PIX)
  paymentMode       SalePaymentMode   @default(CASH)
  installmentsCount Int               @default(1)
  firstDueDate      DateTime?
  period            InstallmentPeriod @default(MONTHLY)
  subtotal          Decimal           @db.Decimal(14, 2)
  discountAmount    Decimal           @default(0) @db.Decimal(14, 2)
  total             Decimal           @db.Decimal(14, 2)
  notes             String?           @db.Text
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  seller             User                @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  items              SaleItem[]
  inventoryMovements InventoryMovement[]
  accountReceivable    AccountReceivable?
  communications       Communication[]
  operationalDocuments OperationalDocument[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, customerId])
  @@index([companyId, sellerId])
  @@index([companyId, completedAt])
}

model SaleItem {
  id             String      @id @default(cuid())
  companyId      String
  saleId         String
  productId      String
  productName    String
  productSku     String
  productType    ProductType
  quantity       Int
  unitPrice      Decimal     @db.Decimal(14, 2)
  discountAmount Decimal     @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal     @db.Decimal(14, 2)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([saleId, sortOrder])
  @@index([productId])
}

model AccountReceivable {
  id              String           @id @default(cuid())
  companyId       String
  saleId          String           @unique
  customerId      String?
  paymentMethod   PaymentMethod
  paymentMode     SalePaymentMode
  totalAmount     Decimal          @db.Decimal(14, 2)
  paidAmount      Decimal          @default(0) @db.Decimal(14, 2)
  remainingAmount Decimal          @db.Decimal(14, 2)
  status          ReceivableStatus @default(PENDING)
  dueDate         DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  installments Installment[]

  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@index([companyId, customerId])
  @@index([companyId, createdAt])
}

model Installment {
  id                  String           @id @default(cuid())
  companyId           String
  accountReceivableId String
  number              Int
  amount              Decimal          @db.Decimal(14, 2)
  paidAmount          Decimal          @default(0) @db.Decimal(14, 2)
  remainingAmount     Decimal          @db.Decimal(14, 2)
  dueDate             DateTime
  status              ReceivableStatus @default(PENDING)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountReceivable AccountReceivable    @relation(fields: [accountReceivableId], references: [id], onDelete: Cascade)
  payments          InstallmentPayment[]
  communications    Communication[]

  @@unique([accountReceivableId, number])
  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@index([accountReceivableId])
}

model InstallmentPayment {
  id            String        @id @default(cuid())
  companyId     String
  installmentId String
  amount        Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod
  paidAt        DateTime      @default(now())
  notes         String?       @db.Text
  paidById      String?
  createdAt     DateTime      @default(now())

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  installment          Installment           @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  paidBy               User?                 @relation("InstallmentPaymentReceiver", fields: [paidById], references: [id], onDelete: SetNull)
  operationalDocuments OperationalDocument[]

  @@index([companyId, paidAt])
  @@index([installmentId, createdAt])
  @@index([paidById])
}

model Supplier {
  id         String         @id @default(cuid())
  companyId  String
  name       String
  tradeName  String?
  document   String?
  email      String?
  phone      String?
  mobile     String?
  zipCode    String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  country    String         @default("BR")
  status     SupplierStatus @default(ACTIVE)
  notes      String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([companyId, status])
  @@index([companyId, name])
  @@index([companyId, document])
  @@index([companyId, createdAt])
}

model Purchase {
  id             String         @id @default(cuid())
  companyId      String
  supplierId     String
  createdById    String
  number         Int
  status         PurchaseStatus @default(DRAFT)
  subtotal       Decimal        @db.Decimal(14, 2)
  discountAmount Decimal        @default(0) @db.Decimal(14, 2)
  total          Decimal        @db.Decimal(14, 2)
  notes          String?        @db.Text
  purchasedAt    DateTime       @default(now())
  receivedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy          User                @relation("PurchaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items                PurchaseItem[]
  inventoryMovements   InventoryMovement[]
  operationalDocuments OperationalDocument[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([companyId, supplierId])
  @@index([companyId, receivedAt])
}

model PurchaseItem {
  id             String      @id @default(cuid())
  companyId      String
  purchaseId     String
  productId      String
  productName    String
  productSku     String
  productType    ProductType
  quantity       Int
  unitCost       Decimal     @db.Decimal(14, 2)
  discountAmount Decimal     @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal     @db.Decimal(14, 2)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([purchaseId, sortOrder])
  @@index([productId])
}

model CommunicationTemplate {
  id        String                @id @default(cuid())
  companyId String
  name      String
  channel   CommunicationChannel  @default(WHATSAPP)
  type      CommunicationType     @default(MANUAL)
  subject   String?
  body      String                @db.Text
  active    Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  deletedAt DateTime?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  communications Communication[]

  @@index([companyId, deletedAt])
  @@index([companyId, channel, active])
  @@index([companyId, createdAt])
}

model Communication {
  id             String                @id @default(cuid())
  companyId      String
  customerId     String?
  userId         String
  templateId     String?
  activityId     String?
  saleId         String?
  installmentId  String?
  channel        CommunicationChannel
  type           CommunicationType     @default(MANUAL)
  origin         CommunicationOrigin   @default(MANUAL)
  status         CommunicationStatus   @default(PREPARED)
  subject        String?
  body           String                @db.Text
  recipient      String?
  externalId     String?
  preparedAt     DateTime              @default(now())
  openedAt       DateTime?
  sentAt         DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user        User                    @relation("CommunicationAuthor", fields: [userId], references: [id], onDelete: Restrict)
  template    CommunicationTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  activity    Activity?               @relation(fields: [activityId], references: [id], onDelete: SetNull)
  sale        Sale?                   @relation(fields: [saleId], references: [id], onDelete: SetNull)
  installment Installment?            @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId, channel])
  @@index([companyId, type])
  @@index([companyId, customerId, createdAt])
  @@index([companyId, userId, createdAt])
  @@index([saleId])
  @@index([installmentId])
  @@index([activityId])
}

model Notification {
  id              String           @id @default(cuid())
  companyId       String
  userId          String
  type            NotificationType
  title           String
  message         String
  link            String?
  readAt          DateTime?
  metadata        Json?
  idempotencyKey  String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, userId, createdAt])
  @@index([companyId, userId, readAt])
  @@index([companyId, type, createdAt])
}

model DocumentSequence {
  id        String                   @id @default(cuid())
  companyId String
  kind      OperationalDocumentKind
  lastValue Int                      @default(0)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind])
}

model OperationalDocument {
  id                   String                   @id @default(cuid())
  companyId            String
  kind                 OperationalDocumentKind
  number               Int
  saleId               String?
  purchaseId           String?
  installmentPaymentId String?
  createdAt            DateTime                 @default(now())
  createdById          String?

  company              Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy            User?                @relation("OperationalDocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sale                 Sale?                @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase             Purchase?            @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  installmentPayment   InstallmentPayment?  @relation(fields: [installmentPaymentId], references: [id], onDelete: SetNull)

  @@unique([companyId, kind, number])
  @@index([companyId, createdAt])
  @@index([companyId, saleId])
  @@index([companyId, purchaseId])
  @@index([companyId, installmentPaymentId])
}
